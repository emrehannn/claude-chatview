#!/usr/bin/env node
// Bootstrap: CommonJS on purpose (bin/package.json), so an extensionless
// file loads the same on every node >= 18; the program is lib/statusline.mjs.
'use strict';
const path = require('path');
const { pathToFileURL } = require('url');
import(pathToFileURL(path.join(__dirname, '..', 'lib', 'statusline.mjs')).href).catch((err) => {
  process.stderr.write(`claude-chatview-statusline: ${err && err.stack || err}\n`);
  process.exit(1);
});
